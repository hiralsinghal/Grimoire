---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/^\/|\/$/g, "");
---

<div class="topbar">
  <a href="/" class="logo">
    <img src="/grimoire_logo.png" alt="Grimoire Logo" />
  </a>

  <nav class="nav">
    <a href="/" class={currentPath === "" ? "active" : ""}>Grimoire</a>
    <a href="/how-it-works" class={currentPath === "about" ? "active" : ""}>How It Works</a>
    <a href="/about" class={currentPath === "about" ? "active" : ""}>About Us</a>
  </nav>
</div>

<style>
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 24px;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    background-color: transparent;
    width: 100%;
    box-sizing: border-box;
}

  .logo {
    display: flex;
    align-items: center;
    margin-left: 36px;
    margin-top: 36px;
  }

  .logo img {
    height: 72px;
    width: auto;
  }

  .nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    width: auto;
    margin-right: 36px;
    margin-top: 36px;
    flex-wrap: wrap;
    justify-content: flex-end;
    padding: 10px 14px;
    border-radius: 10px;
    backdrop-filter: blur(4px);
    color: #F6EEDF;
    font-family: "Gentium Book Plus", serif;
    font-weight: 700;
    font-size: 100%;
  }

  .nav a {
    color: #F6EEDF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px 16px;
    text-decoration: none;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0.3px;
    opacity: 0.98;
    border-radius: 6px;
    line-height: 1;
  }

  .nav a:hover,
  .nav a.active {
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
  }
</style>