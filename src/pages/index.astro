---
import Layout from '../layouts/Layout.astro';
import '../styles/index.css';
---

<Layout title="Grimoire">
  <div class="layout">
    <main class="common_style">

      <div class="search-container">
        <input type="text" placeholder="Enter a book..." id="bookSearch" list="bookList" />
        <datalist id="bookList"></datalist>
        <button type="button" id="searchBtn">Recommend</button>
      </div>

      <div id="results" class="results"></div>
    </main>

    <section id="welcome" class="common_style">
      <h2>Welcome to NovaRec! (Or Grimoire, the name is still a work in progress)</h2>
      <p>The backend is now integrated — search for a book above to get recommendations.</p>
    </section>

    <section id="objective" class="common_style">
      <h2>Objective of the Project:</h2>
      <p>NovaRec aims to address various issues faced by readers all over the globe on a regular basis. Through our own struggles, we identified the need for an intelligent system that could:</p>
      <ul>
        <li>Understand books beyond basic genre classifications to match plots and themes</li>
        <li>Provide personalised recommendations based on what readers have enjoyed</li>
        <li>Save time by finding recommendations immediately</li>
        <li>Connect readers with books they might never find through traditional methods</li>
      </ul>
    </section>

    <section id="process" class="common_style">
      <h2>How does it work?</h2>
      <p>User first inputs a book they have already read</p>
    </section>
  </div>
</Layout>

<script>
  const searchBtn = document.getElementById('searchBtn');
  const bookSearch = document.getElementById('bookSearch') as HTMLInputElement;
  const resultsDiv = document.getElementById('results');

  searchBtn?.addEventListener('click', async () => {
    const query = bookSearch?.value;
    if (!query) return;

    if (resultsDiv) {
      resultsDiv.innerHTML = '<div class="results-status">Searching recommendations...</div>';
    }

    try {
      const response = await fetch(`/api/recommend?title=${encodeURIComponent(query)}`);
      const data = await response.json();

      if (data.error) {
        if (resultsDiv) {
          resultsDiv.innerHTML = `<div class="results-status results-error">${data.error}</div>`;
        }
        return;
      }

      if (resultsDiv) {
        const cardsHtml = data.recommendations.map((b: { title: string; author: string; genre: string }) => `
          <li class="result-card">
            <h3>${b.title}</h3>
            <p class="result-meta">By <strong>${b.author}</strong></p>
            <p class="result-meta">Genre: ${b.genre}</p>
          </li>
        `).join('');

        resultsDiv.innerHTML = `
          <div class="results-status">Recommended Books:</div>
          <ul class="result-list">${cardsHtml}</ul>
        `;
      }
    } catch (err) {
      if (resultsDiv) {
        resultsDiv.innerHTML = '<div class="results-status results-error">Error fetching recommendations.</div>';
      }
    }
  });
</script>